# ─── Server ───────────────────────────────────────────────
PORT=3001

# ─── Database ─────────────────────────────────────────────
# On Railway, mount a volume at /data and set:
DB_PATH=/data/goalrush.db

# ─── Free Football API (optional but recommended) ──────────
# Sign up FREE at https://www.football-data.org/
# Free tier: 10 req/min, covers PL, La Liga, Bundesliga, Serie A, etc.
FOOTBALL_DATA_KEY=your_free_key_here

# ─── Smart Contract (for auto-resolution) ─────────────────
# The private key of the wallet that has ORACLE role on your contract
# NEVER commit this — set in Railway dashboard only
ORACLE_PRIVATE_KEY=0x...

# Your deployed GoalRush contract address
CONTRACT_ADDRESS=0x...

# Free RPC URLs (pick one):
# Polygon:  https://polygon-rpc.com
# BSC:      https://bsc-dataseed.binance.org
# Alchemy:  https://polygon-mainnet.g.alchemy.com/v2/YOUR_FREE_KEY
RPC_URL=https://polygon-rpc.com

# ─── Admin ────────────────────────────────────────────────
# Secret header for /api/admin/resolve endpoint
ADMIN_SECRET=change_this_to_something_random
