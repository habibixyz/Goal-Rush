# ─── Server ───────────────────────────────────────────────
PORT=3001

# ─── Database ─────────────────────────────────────────────
# On Railway, mount a volume at /data and set:
DB_PATH=/data/goalrush.db

# ─── Free Football API (optional but recommended) ──────────
# Sign up FREE at https://www.football-data.org/
# Free tier: 10 req/min, covers PL, La Liga, Bundesliga, Serie A, etc.
FOOTBALL_DATA_KEY=your_free_key_here

# ─── GoalRush On-Chain Keeper ─────────────────────────────
# Private key of the wallet that owns the GoalRush Hook contract.
# Used to auto-activate and resolve matches on X Layer Mainnet.
# NEVER commit this — set in Railway dashboard → Variables only.
KEEPER_PRIVATE_KEY=0xYOUR_OWNER_WALLET_PRIVATE_KEY_HERE

# GoalRush Hook contract address on X Layer Mainnet
HOOK_ADDRESS=0xC907030AeCd8fC81B19678cDD08DCF96cD9380c0

# X Layer Mainnet RPC
XLAYER_RPC=https://rpc.xlayer.tech

# ─── Legacy resolver (can leave blank if using keeper above) ─
ORACLE_PRIVATE_KEY=
CONTRACT_ADDRESS=
RPC_URL=

# ─── Admin ────────────────────────────────────────────────
# Secret header for /api/admin/resolve endpoint
ADMIN_SECRET=change_this_to_something_random
