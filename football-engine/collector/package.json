    "prisma:generate": "prisma generate --schema=../prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^5.13.0",
    "dotenv": "^16.4.5",
    "ioredis": "^5.4.1",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "prisma": "^5.13.0",
    "tsx": "^4.10.1",
    "typescript": "^5.4.5"
  }
}
